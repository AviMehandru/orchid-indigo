<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:YtdlWin.Views"
    xmlns:app="using:YtdlWin">

    <!-- Declared in THIS dictionary, not App.xaml. A Generic.xaml template is
         resolved against its own dictionary; a StaticResource here pointing at
         an application-level key is not reliably reachable at the moment a
         template is inflated. -->
    <app:EmptyStringToCollapsedConverter x:Key="EmptyStringToCollapsed" />

    <!--
        Themes/Generic.xaml, at exactly this path and with exactly this name.

        A control that sets DefaultStyleKey looks its template up here, by type,
        and nowhere else. Getting the path wrong does not produce an error: the
        control is constructed, finds no template, lays out as a zero-height
        nothing, and the page renders with the options simply absent. That is
        the single most confusing failure mode in this file's vicinity, which is
        why the requirement is written down rather than assumed.
    -->
    <Style TargetType="views:OptionRow">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="Margin" Value="0,0,0,3" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="views:OptionRow">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="{TemplateBinding Header}" TextWrapping="Wrap" />
                                <!--
                                    Collapsed when there is no description, so a
                                    row without one is not a row with a blank
                                    line under its label. TextWrapping is set
                                    because an unwrapped TextBlock reports its
                                    minimum width as its natural width, and
                                    these descriptions are sentences.
                                -->
                                <TextBlock Text="{TemplateBinding Description}"
                                           TextWrapping="Wrap"
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Visibility="{Binding Description, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource EmptyStringToCollapsed}}" />
                            </StackPanel>

                            <ContentPresenter
                                Grid.Column="1"
                                Content="{TemplateBinding Content}"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
