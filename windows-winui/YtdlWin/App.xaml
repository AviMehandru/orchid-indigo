<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="YtdlWin.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        There is no theme here and no colour of this app's own, deliberately.

        The GTK app carries a stylesheet because libadwaita has no label-sized
        status widget and no media card. WinUI's own resource dictionary covers
        both: a pill is a Border with a theme brush, a card is a Border with
        CardBackgroundFillColorDefaultBrush, and every one of those follows the
        system light/dark setting and the user's accent colour without this file
        naming a single colour value. That following-the-system property is the
        whole point of the CSS it replaces, so hardcoding a palette here to make
        the three apps look identical would trade the thing that matters for the
        thing that does not.
    -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Shared metrics, so the four pages agree without repeating numbers. -->
            <x:Double x:Key="PaneMaxWidth">900</x:Double>
            <Thickness x:Key="PagePadding">16</Thickness>
            <Thickness x:Key="SectionSpacing">0,0,0,20</Thickness>

            <Style x:Key="SectionHeader" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                <Setter Property="Margin" Value="0,0,0,8" />
            </Style>

            <Style x:Key="CaptionSecondary" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <!--
                    WRAPPING, NOT TRUNCATING, and every long caption in this app
                    says so explicitly. This is the WinUI spelling of a trap the
                    GTK app hit for real: a label with neither wrap nor ellipsis
                    reports its minimum width as its natural width, every
                    container above it inherits that, and one transcript note
                    ended up setting the whole window's minimum width to 507px.
                    A TextBlock defaults to NoWrap, so leaving this off is the
                    version of that bug this toolkit gives you for free.
                -->
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="MonoText" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Consolas, Cascadia Mono, Courier New" />
                <Setter Property="IsTextSelectionEnabled" Value="True" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="CardBorder" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{ThemeResource OverlayCornerRadius}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
