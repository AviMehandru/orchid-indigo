<?xml version="1.0" encoding="utf-8"?>
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">

  <!--
    Two settings, both load-bearing for this particular app.

    longPathAware lifts MAX_PATH for this process on Windows 10 1607 and later.
    It is required and it is NOT sufficient: it only takes effect when the
    machine's LongPathsEnabled policy is also on, which on a default install it
    is not. Paths.Extended() is the other half, and the reason both exist is at
    the top of Paths.cs -- this pipeline's per-video paths run to about 240
    characters before the data root is prefixed, so a Windows reader that does
    nothing about this silently loses the most deeply nested files in a video
    folder and shows a short library with no error anywhere.

    dpiAware/dpiAwareness is what stops the window being bitmap-stretched on a
    high-DPI display. WinUI 3 sets per-monitor v2 awareness itself in most
    hosting shapes, and declaring it here as well is harmless and explicit.
  -->

  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <longPathAware xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">true</longPathAware>
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true/pm</dpiAware>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2</dpiAwareness>
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
    </windowsSettings>
  </application>

  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 and 11. Declaring these is what stops the OS applying
           compatibility shims meant for pre-Windows-8 software. -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
      <supportedOS Id="{1f676c76-80e1-4239-95bb-83d0f6d0da78}" />
    </application>
  </compatibility>

  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v2">
    <security>
      <requestedPrivileges xmlns="urn:schemas-microsoft-com:asm.v3">
        <!-- asInvoker, and never anything else. This app reads an archive and
             spawns a PowerShell script; nothing it does needs elevation, and a
             download run as administrator would write files the ordinary user
             then cannot manage. -->
        <requestedExecutionLevel level="asInvoker" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>

</assembly>
