<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Package versions below are the ones a real restore resolved on 2026-09-09,
    not guesses: Microsoft.WindowsAppSDK 2.4.0. The first attempt pinned 1.6.x,
    which was a major version behind.

    Microsoft.Windows.SDK.BuildTools is deliberately NOT referenced here.
    Nothing in this project uses it directly; the App SDK depends on it and
    knows which version it needs. Pinning it as well is how the first build
    failed: an explicit reference at 10.0.26100.1742 sat below the
    10.0.26100.4654 that WindowsAppSDK 2.4.0 requires, and NuGet treats a
    direct reference below a transitive requirement as a downgrade and refuses
    it outright (NU1605). Adding it back means owning that version forever.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <!--
      17763 (1809) rather than something newer. The floor is set by what the
      pipeline itself needs and by long-path support, which arrived in 1607;
      anything later would be excluding machines for no reason this app can
      point at.
    -->
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>YtdlWin</RootNamespace>
    <AssemblyName>YtdlWin</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <Nullable>enable</Nullable>
    <LangVersion>12.0</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>

    <!--
      UNPACKAGED by default. The pipeline lives at C:\yt-dlp and this app reads
      an archive anywhere on disk; an MSIX package would put it in a container
      whose filesystem access is a separate conversation, for no benefit to a
      tool somebody installs alongside a PowerShell pipeline. Set
      WindowsPackageType back to MSIX and add a Package.appxmanifest if a
      packaged build is ever wanted — everything in the app is written to work
      either way, which is why Settings uses a plain JSON file rather than
      ApplicationData.Current (that API throws outright when unpackaged).
    -->
    <WindowsPackageType>None</WindowsPackageType>
    <EnableMsixTooling>false</EnableMsixTooling>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>

    <!--
      OFF, and this is the same compromise the macOS app records at the bottom
      of its README: the GTK app builds with -Werror and this should too. It is
      off because a deprecation notice failing the build before the first clean
      one would be noise rather than signal, and this code has never seen a
      compiler at all. Turn it on once it compiles clean — it is this one line.
    -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <WarningLevel>5</WarningLevel>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.4.0" />
  </ItemGroup>

  <ItemGroup>
    <!--
      CLI_VERSION is at the REPOSITORY root, two levels up, and is copied next
      to the binary so both the Health pane and the conformance suite read the
      same file the installer does. Linked rather than copied into the project
      directory: two copies of the one pin is exactly what CLI_VERSION exists to
      prevent.
    -->
    <None Include="..\..\CLI_VERSION" Link="CLI_VERSION">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
