<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="YtdlWin.Views.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:local="using:YtdlWin.Views">

    <!-- Declared BEFORE the content that uses it. StaticResource is resolved at
         parse time in document order, so a template defined below its use site
         fails to resolve rather than being found later. -->
    <Page.Resources>
        <DataTemplate x:Key="VideoCardTemplate" x:DataType="local:VideoCardModel">
            <Border Width="248" Margin="0,0,12,12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8">
                <StackPanel>
                    <Grid Height="139">
                        <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" />
                        <Image Source="{x:Bind Thumbnail}" Stretch="UniformToFill" />
                        <FontIcon Glyph="&#xE8B2;" FontSize="22"
                                  Visibility="{x:Bind PlaceholderVisibility}"
                                  Foreground="{ThemeResource TextFillColorTertiaryBrush}" />

                        <!--
                            The duration goes ON the thumbnail, where every video
                            player and every video site puts it — not in the
                            subtitle competing with the channel name and the date
                            for the same run of small grey text. Collapsed rather
                            than blank when there is no duration: an empty badge
                            is a dark smudge in the corner of the image.
                        -->
                        <Border HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                Margin="6" Padding="6,1" CornerRadius="4"
                                Background="#B8000000"
                                Visibility="{x:Bind DurationVisibility}">
                            <TextBlock Text="{x:Bind Duration}" FontSize="11" Foreground="White"
                                       FontWeight="Bold" />
                        </Border>
                    </Grid>

                    <StackPanel Padding="10" Spacing="4">
                        <TextBlock Text="{x:Bind Title}" MaxLines="2" TextWrapping="Wrap"
                                   TextTrimming="CharacterEllipsis"
                                   FontWeight="SemiBold" FontSize="13" />
                        <TextBlock Text="{x:Bind Subtitle}" MaxLines="1"
                                   TextTrimming="CharacterEllipsis"
                                   Style="{StaticResource CaptionSecondary}"
                                   TextWrapping="NoWrap" />
                        <!--
                            A single pill, not an ItemsControl of them. A UIElement
                            can have exactly one parent, and a GridView RECYCLES its
                            item containers as it scrolls — so handing a list of
                            live Border objects to an ItemsControl inside a
                            virtualised template is the classic "Element is already
                            the child of another element" crash, hit only once the
                            user scrolls far enough to reuse a container. Bound text
                            has no such problem.
                        -->
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Border Visibility="{x:Bind BadgeVisibility}"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    CornerRadius="9" Padding="8,2"
                                    HorizontalAlignment="Left">
                                <TextBlock Text="{x:Bind BadgeText}" FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Border>
                            <!--
                                Watch state, as a SECOND pill. A "watched" flag
                                you can only filter by and never see is half a
                                feature: the question in front of someone
                                scrolling a library is "have I seen this one",
                                and a facet answers it only by hiding
                                everything else.
                            -->
                            <Border Visibility="{x:Bind WatchedVisibility}"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    CornerRadius="9" Padding="8,2"
                                    HorizontalAlignment="Left">
                                <TextBlock Text="watched" FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!-- The index banner, which is collapsed most of the time and must
                 not reserve space when it is. -->
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Padding="14,12,14,6" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="Library" Style="{StaticResource TitleTextBlockStyle}" />

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <!--
                    WHERE a search looks. It belongs beside the search box and
                    it is not, because NavigationView.AutoSuggestBox takes
                    exactly one element and there is no room next to it — the
                    GTK and SwiftUI apps both put their scope control against
                    the field. This is the platform's constraint rather than a
                    design choice, so the label says "Search in" to tie the two
                    together across the gap.

                    Offered at all because it is the only affordance that tells
                    anyone the comments and captions are searchable, which was
                    the entire gap.
                -->
                <TextBlock Text="Search in" VerticalAlignment="Center"
                           Style="{StaticResource CaptionSecondary}" />
                <ComboBox x:Name="SearchScopeBox" MinWidth="150"
                          SelectionChanged="OnSearchScopeChanged"
                          ToolTipService.ToolTip="Which text the search box looks at" />

                <!--
                    The sort and facet control. A DropDownButton whose flyout is
                    built in code rather than declared here, because the channel
                    list is the ARCHIVE's — it changes on every scan, and a XAML
                    ItemsSource binding would need a whole observable layer to
                    say what one rebuild says directly.

                    The count of active facets is in the BUTTON'S LABEL, not a
                    badge drawn over its icon. A facet still narrowing the
                    library after the flyout has been closed and forgotten is
                    the one state this UI can get wrong in a way that reads as
                    lost videos, so the button visibly changes while one is on.
                -->
                <DropDownButton x:Name="FilterButton"
                                ToolTipService.ToolTip="Sort and filter the library">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE71C;" FontSize="14" />
                        <TextBlock x:Name="FilterLabel" Text="Filter" />
                    </StackPanel>
                </DropDownButton>

                <Button x:Name="RescanButton" Click="OnRescan"
                        ToolTipService.ToolTip="Re-read the archive from disk (Ctrl+R)">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE72C;" FontSize="14" />
                        <TextBlock Text="Rescan" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!--
            The only place the app can be honest about what a collection-wide
            search can currently SEE. A comment search against an index that
            covers none of the archive returns nothing, and "no results" is a
            lie about the archive rather than a fact about it.

            An InfoBar rather than a ContentDialog or a transient message: the
            fact it carries stays true until somebody acts on it, and it closes
            itself when the condition goes away. IsClosable is false for the
            same reason — dismissing it would not make the index exist.
        -->
        <muxc:InfoBar x:Name="IndexBanner" Grid.Row="1" Margin="14,0,14,8"
                      IsOpen="False" IsClosable="False" Severity="Informational">
            <muxc:InfoBar.ActionButton>
                <Button x:Name="IndexBuildButton" Content="Build index" Click="OnBuildIndex" />
            </muxc:InfoBar.ActionButton>
        </muxc:InfoBar>

        <!--
            GridView, not an ItemsRepeater in a ScrollViewer.

            GridView virtualises out of the box — it realises only the cards
            that are on screen, so an archive with several thousand videos costs
            the same to open as one with twenty, which is the shape of archive
            this tool exists to produce. It also brings keyboard navigation,
            type-ahead, and ItemInvoked (which fires on a single click, on
            Enter, and on a touch tap) rather than three hand-wired gestures.
        -->
        <muxc:GridView
            x:Name="Grid_"
            Grid.Row="2"
            Padding="14,6,14,14"
            IsItemClickEnabled="True"
            SelectionMode="Single"
            ItemClick="OnItemClick"
            ItemTemplate="{StaticResource VideoCardTemplate}">
            <muxc:GridView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="0" />
                </ItemsPanelTemplate>
            </muxc:GridView.ItemsPanel>
        </muxc:GridView>

        <!--
            The empty state. Not a centred label: this is the shape Windows uses
            for "nothing here", and it says WHY rather than just that.
        -->
        <StackPanel
            x:Name="EmptyState"
            Grid.Row="2"
            Visibility="Collapsed"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            MaxWidth="440"
            Spacing="10">
            <FontIcon Glyph="&#xE8B2;" FontSize="34"
                      Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            <TextBlock x:Name="EmptyTitle" Text="Nothing to show" HorizontalAlignment="Center"
                       Style="{StaticResource SubtitleTextBlockStyle}" />
            <TextBlock x:Name="EmptyDetail" TextWrapping="Wrap" TextAlignment="Center"
                       Style="{StaticResource CaptionSecondary}" />
            <!--
                Offered only when filters are what emptied the grid. A "Clear
                filters" button under "there is no archive here" would be a
                control that does nothing, next to a message about a different
                problem entirely.
            -->
            <Button x:Name="EmptyClear" Content="Clear filters" Click="OnClearFilters"
                    HorizontalAlignment="Center" Visibility="Collapsed" />
        </StackPanel>
    </Grid>

</Page>
