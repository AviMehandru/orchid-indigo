<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="YtdlWin.Views.DownloadsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:local="using:YtdlWin.Views">

    <!--
        The command preview above the button is not decoration. A GUI that hides
        the command it runs makes the CLI harder to learn rather than easier, and
        every problem report about this app is easier to answer when the user can
        paste the exact line the window would have run.

        The form is a column of OptionRow, which is this app's own stand-in for
        the boxed AdwPreferencesGroup lists the GTK app uses and the grouped Form
        the macOS one uses: label, control, and a one-line explanation underneath
        instead of a tooltip nobody hovers over.

        The Windows control that looks exactly like this is SettingsCard, and it
        is deliberately not used — it lives in the WinUI Community Toolkit,
        which is a third-party package, and every app in this repository depends
        only on what its own platform ships. See Views/OptionRow.cs.

        The split between the form and the run area is draggable because the two
        halves are wanted in different proportions at different times: all form
        while setting a run up, all log while watching one. A fixed ratio would
        be wrong in both states.
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="3*" MinHeight="220" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" MinHeight="200" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" Padding="16" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="{StaticResource PaneMaxWidth}" HorizontalAlignment="Left" Spacing="4">

                <TextBlock Text="Downloads" Style="{StaticResource TitleTextBlockStyle}"
                           Margin="0,0,0,10" />

                <!-- Profile -->
                <TextBlock Text="Profile" Style="{StaticResource SectionHeader}" />
                <local:OptionRow Header="Active profile"
                                   Description="Applies its options and leaves the URL alone — a preset that replaced what you were about to download would be the one thing a preset must never do.">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <ComboBox x:Name="ProfileBox" MinWidth="180"
                                  SelectionChanged="OnProfileSelected" />
                        <Button Click="OnSaveProfile" ToolTipService.ToolTip="Save these options as a profile — every option except the URL.">
                            <FontIcon Glyph="&#xE74E;" FontSize="14" />
                        </Button>
                        <Button Click="OnRenameProfile" ToolTipService.ToolTip="Rename the selected profile">
                            <FontIcon Glyph="&#xE70F;" FontSize="14" />
                        </Button>
                        <Button Click="OnDeleteProfile" ToolTipService.ToolTip="Delete the selected profile">
                            <FontIcon Glyph="&#xE74D;" FontSize="14" />
                        </Button>
                    </StackPanel>
                </local:OptionRow>
                <TextBlock x:Name="ProfileStatus" Style="{StaticResource CaptionSecondary}"
                           Margin="0,4,0,12" />

                <!-- Download -->
                <TextBlock Text="Download" Style="{StaticResource SectionHeader}" />
                <local:OptionRow Header="URL" Description="A video, playlist or channel.">
                    <TextBox x:Name="UrlBox" MinWidth="320" TextChanged="OnUrlChanged"
                             PlaceholderText="https://www.youtube.com/watch?v=…" />
                </local:OptionRow>

                <local:OptionRow Header="Destination"
                                   Description="Empty means the pipeline's own default, which is the install root.">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBox x:Name="DataRootBox" MinWidth="260" TextChanged="OnDataRootChanged" />
                        <Button Content="Choose…" Click="OnChooseFolder" />
                    </StackPanel>
                </local:OptionRow>

                <!-- Format -->
                <TextBlock Text="Format" Style="{StaticResource SectionHeader}" Margin="0,12,0,8" />
                <local:OptionRow Header="Mode" Description="Which parts of each video to fetch.">
                    <ComboBox x:Name="ModeBox" MinWidth="180" SelectionChanged="OnOptionChanged" />
                </local:OptionRow>
                <local:OptionRow Header="Quality"
                                   Description="A ceiling, not a demand — a video that was never published at this height comes down at the best it has.">
                    <ComboBox x:Name="QualityBox" MinWidth="180" SelectionChanged="OnOptionChanged" />
                </local:OptionRow>
                <local:OptionRow Header="Video codec"
                                 Description="AVC1 is the one Windows always decodes in this window. VP9 and AV1 are smaller at the same quality but need a media extension from the Store to play here — the file is still archived correctly either way.">
                    <ComboBox x:Name="CodecBox" MinWidth="180" SelectionChanged="OnOptionChanged" />
                </local:OptionRow>
                <local:OptionRow Header="Audio codec"
                                 Description="Opus is what YouTube serves natively, so leaving this alone avoids a re-encode. AAC is the safer choice if these files will be played by something old.">
                    <ComboBox x:Name="AudioCodecBox" MinWidth="180" SelectionChanged="OnOptionChanged" />
                </local:OptionRow>
                <local:OptionRow Header="Container"
                                   Description="MKV keeps everything the pipeline embeds. MP4 with the AVC1 codec is the combination Windows can always play in this window without a Store media extension.">
                    <ComboBox x:Name="ContainerBox" MinWidth="180" SelectionChanged="OnOptionChanged" />
                </local:OptionRow>
                <local:OptionRow Header="Workers"
                                   Description="The pipeline's own parallelism. The queue here is always sequential, because independent ytdl invocations race on the shared manifests — --workers is the supported way to run several at once.">
                    <muxc:NumberBox x:Name="WorkersBox" Minimum="1" Maximum="16"
                                    SpinButtonPlacementMode="Compact" MinWidth="120"
                                    ValueChanged="OnWorkersChanged" />
                </local:OptionRow>

                <!-- Passes -->
                <TextBlock Text="Passes" Style="{StaticResource SectionHeader}" Margin="0,12,0,4" />
                <TextBlock Style="{StaticResource CaptionSecondary}" Margin="0,0,0,8"
                           Text="Everything is on by default. Turning a pass off makes a run faster and the archive less complete." />
                <StackPanel x:Name="PassesPanel" Spacing="4" />

                <!-- Advanced -->
                <TextBlock Text="Advanced" Style="{StaticResource SectionHeader}" Margin="0,12,0,8" />
                <local:OptionRow Header="Extra yt-dlp arguments"
                                 Description="One per line. A real --match-filter expression contains commas and spaces, so there is no separator a single-line field could safely split on."
                                 HorizontalContentAlignment="Stretch">
                    <TextBox x:Name="ExtraArgsBox" AcceptsReturn="True" Height="80" MinWidth="320"
                             FontFamily="Consolas, Cascadia Mono, Courier New"
                             TextWrapping="Wrap" TextChanged="OnExtraArgsChanged" />
                </local:OptionRow>

                <Border Style="{StaticResource CardBorder}" Padding="12" Margin="0,10,0,0">
                    <StackPanel Spacing="4">
                        <TextBlock Text="This is the command that will run"
                                   Style="{StaticResource CaptionSecondary}" />
                        <TextBlock x:Name="PreviewText" Style="{StaticResource MonoText}"
                                   FontSize="12" />
                    </StackPanel>
                </Border>

                <Button x:Name="AddButton" Click="OnAddToQueue" Margin="0,12,0,0"
                        Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE710;" FontSize="14" />
                        <TextBlock Text="Add to queue" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </ScrollViewer>

        <!-- Draggable, for the reason at the top of this file. -->
        <Border Grid.Row="1" Height="6" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

        <Grid Grid.Row="2" Padding="16,10,16,12" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
                <Button x:Name="CancelButton" Click="OnCancel" IsEnabled="False"
                        ToolTipService.ToolTip="Kills the whole process tree — ytdl.ps1, the child pwsh, yt-dlp, postprocess.ps1 and ffmpeg — by terminating the job object they all live in. Killing only the top process would leave a download running with nothing reading its output.">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE71A;" FontSize="14" />
                        <TextBlock Text="Cancel run" />
                    </StackPanel>
                </Button>
                <Button x:Name="PauseButton" Click="OnTogglePause" Content="Pause queue" />
                <TextBlock x:Name="StageText" VerticalAlignment="Center"
                           Style="{StaticResource CaptionSecondary}"
                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Text="Idle" />
            </StackPanel>

            <muxc:ProgressBar x:Name="Progress" Grid.Row="1" Value="0" Maximum="100" />

            <!--
                A ListView of lines rather than one big TextBlock. Appending to a
                TextBlock's Text re-lays out the whole document on every redraw,
                and a sync run over a large channel produces thousands of lines. The
                transient line is a separate row pinned at the bottom, which is
                what makes a \r redraw replace its predecessor instead of adding
                a row.
            -->
            <Border Grid.Row="2" Style="{StaticResource CardBorder}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ListView x:Name="LogList" Grid.Row="0" SelectionMode="None"
                              IsItemClickEnabled="False" Padding="6">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="MinHeight" Value="0" />
                                <Setter Property="Padding" Value="4,1" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <TextBlock Text="{x:Bind}" FontSize="12"
                                           FontFamily="Consolas, Cascadia Mono, Courier New"
                                           IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock x:Name="TransientLine" Grid.Row="1" Margin="10,0,10,6"
                               FontSize="12" FontFamily="Consolas, Cascadia Mono, Courier New"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                </Grid>
            </Border>

            <Grid Grid.Row="3" ColumnSpacing="12" Height="150">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock x:Name="QueueHeader" Text="Queue (0)"
                               Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock x:Name="QueueEmpty" Style="{StaticResource CaptionSecondary}"
                               Text="Nothing queued. Paste a URL above and press Add to queue." />
                    <ListView x:Name="QueueList" Height="110" SelectionMode="None" />
                </StackPanel>

                <StackPanel Grid.Column="1" Spacing="4">
                    <Grid>
                        <TextBlock x:Name="HistoryHeader" Text="History (0)"
                                   Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <HyperlinkButton x:Name="ClearHistoryButton" Content="Clear"
                                         HorizontalAlignment="Right" Padding="4,0"
                                         Click="OnClearHistory" />
                    </Grid>
                    <TextBlock x:Name="HistoryEmpty" Style="{StaticResource CaptionSecondary}"
                               Text="No runs yet." />
                    <ListView x:Name="HistoryList" Height="110" SelectionMode="None" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Page>
